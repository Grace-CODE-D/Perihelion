# Perihelion Docker Compose environment variables
# Copy this file to .env and fill in the required values

# Escrow contract address (shared by mempool, relayer, and solver)
# REQUIRED: the address of a deployed escrow contract. Anvil's first account is an
# EOA, not a contract, so it is not a valid default.
PERIHELION_ESCROW_ADDRESS=

# Settlement contract on Stellar (shared by relayer and solver)
# REQUIRED: the contract id of a deployed settlement contract on the local network.
# This is the single unified name for the settlement contract id; the legacy
# PERIHELION_SETTLEMENT_CONTRACT name is accepted for one release with a
# deprecation warning.
PERIHELION_SETTLEMENT_CONTRACT_ID=

# Solver mode (solver only)
# One of: live, watch
#   live  - the solver evaluates intents and fills them via the executor.
#           Requires PERIHELION_EVM_PRIVATE_KEY and PERIHELION_SOROBAN_SECRET_KEY.
#   watch - dry-run: the solver evaluates intents and logs decisions but never
#           invokes the executor. No executor keys are required.
# Defaults to live when executor configuration is present, otherwise the solver
# exits with a configuration error.
PERIHELION_SOLVER_MODE=live

# Solver identification (EVM address)
# In live mode this MUST match the address derived from
# PERIHELION_EVM_PRIVATE_KEY; the solver refuses to start if they differ.
# In watch mode this is the only source of the solver identity.
PERIHELION_SOLVER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# Relayer signing secret (Stellar S... format, 56 chars)
# REQUIRED: Generate a valid Stellar secret key for local development
# Example: SAAAA... (must pass checksum validation)
SIGNER_SECRET=

# Solver EVM private key (for signing transactions)
# REQUIRED in live mode: Use a valid Ethereum private key for local development
PERIHELION_EVM_PRIVATE_KEY=

# Solver Soroban secret key (Stellar S... format)
# REQUIRED in live mode: Generate a valid Stellar secret key for local development
PERIHELION_SOROBAN_SECRET_KEY=

# Stellar network the solver connects to (required)
# One of: testnet, mainnet, futurenet, local
# Example: STELLAR_NETWORK=testnet
STELLAR_NETWORK=testnet